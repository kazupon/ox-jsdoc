{
  "name": "@ox-jsdoc/eslint-plugin-jsdoc",
  "version": "0.0.19",
  "description": "eslint-plugin-jsdoc fork using @ox-jsdoc/jsdoccomment.",
  "keywords": [
    "eslint",
    "jsdoc",
    "plugin"
  ],
  "homepage": "https://github.com/kazupon/ox-jsdoc/tree/main/packages/eslint-plugin-jsdoc#readme",
  "license": "BSD-3-Clause",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kazupon/ox-jsdoc",
    "directory": "packages/eslint-plugin-jsdoc"
  },
  "funding": "https://github.com/sponsors/kazupon",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.js"
    },
    "./getJsdocProcessorPlugin.js": {
      "types": "./dist/getJsdocProcessorPlugin.d.ts",
      "default": "./src/getJsdocProcessorPlugin.js"
    },
    "./iterateJsdoc.js": {
      "types": "./dist/iterateJsdoc.d.ts",
      "default": "./src/iterateJsdoc.js"
    }
  },
  "files": [
    "/dist",
    "/docs",
    "/src",
    "!/src/bin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "ruleTypes": "node ./src/bin/generateRuleTypes.js",
    "tsc": "tsc",
    "tsc-build": "tsc -p tsconfig-prod.json",
    "prepublishOnly": "pnpm run build",
    "build": "rimraf ./dist && mkdir dist && pnpm run tsc-build && node -e \"require('node:fs').copyFileSync('src/rules.d.ts', 'dist/rules.d.ts')\"",
    "check-docs": "node ./src/bin/generateDocs.js --check",
    "create-docs": "pnpm run create-options && node ./src/bin/generateDocs.js && pnpm run ruleTypes",
    "create-rule": "node ./src/bin/generateRule.js",
    "create-options": "node ./src/bin/generateOptions.js",
    "lint": "eslint",
    "lint-fix": "eslint --fix",
    "test-no-cov": "mocha",
    "test": "c8 pnpm run test-no-cov",
    "test-cov": "cross-env TIMING=1 c8 --reporter text pnpm run test-no-cov",
    "test-index": "pnpm run test-no-cov test/rules/index.js"
  },
  "dependencies": {
    "@es-joy/escodegen": "^4.2.0",
    "@es-joy/resolve.exports": "1.2.0",
    "@ox-jsdoc/jsdoccomment": "workspace:*",
    "are-docs-informative": "^0.1.1",
    "comment-parser": "1.4.9",
    "debug": "^4.4.3",
    "escape-string-regexp": "^5.0.0",
    "espree": "^11.2.0",
    "esquery": "^1.7.0",
    "html-entities": "^2.6.0",
    "jsdoc-type-pratt-parser": "~9.4.0",
    "object-deep-merge": "^2.0.1",
    "parse-imports-exports": "^0.2.4",
    "semver": "^7.8.5",
    "spdx-expression-parse": "^5.0.0",
    "to-valid-identifier": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/eslint-parser": "^8.0.0",
    "@babel/plugin-transform-flow-strip-types": "^8.0.0",
    "@babel/preset-env": "^8.0.0",
    "@es-joy/jsdoc-eslint-parser": "^0.29.0",
    "@eslint/core": "^1.1.1",
    "@types/chai": "^5.2.3",
    "@types/debug": "^4.1.13",
    "@types/esquery": "^1.5.4",
    "@types/estree": "^1.0.8",
    "@types/json-schema": "^7.0.15",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.0.0",
    "@types/semver": "^7.7.1",
    "@types/spdx-expression-parse": "^4.0.0",
    "@typescript-eslint/types": "8.72.0",
    "@typescript-eslint/utils": "8.72.0",
    "babel-plugin-add-module-exports": "^1.0.4",
    "babel-plugin-transform-import-meta": "^3.0.0",
    "c8": "^12.0.0",
    "camelcase": "^9.0.0",
    "chai": "^6.2.2",
    "cross-env": "^10.0.0",
    "decamelize": "^7.0.0",
    "eslint": "9.39.4",
    "eslint-config-canonical": "^47.4.2",
    "gitdown": "^4.1.1",
    "glob": "^13.0.6",
    "globals": "^17.4.0",
    "json-schema": "^0.4.0",
    "json-schema-to-typescript": "^15.0.4",
    "mocha": "^11.7.5",
    "open-editor": "^6.0.0",
    "playwright": "^1.59.0",
    "replace": "^1.2.2",
    "rimraf": "^6.1.3",
    "sinon": "^22.0.0",
    "ts-api-utils": "^2.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "peerDependencies": {
    "eslint": "^7.0.0 || ^8.0.0 || ^9.0.0 || ^10.0.0",
    "typescript": "*"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.js": "eslint --fix"
  },
  "mocha": {
    "recursive": true,
    "reporter": "dot",
    "timeout": 12000
  },
  "c8": {
    "branches": 90,
    "check-coverage": true,
    "exclude": [
      "src/rules/checkExamples.js"
    ],
    "functions": 90,
    "include": [
      "src/"
    ],
    "instrument": false,
    "lines": 90,
    "reporter": "text-summary",
    "sourceMap": false,
    "statements": 90
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  }
}
