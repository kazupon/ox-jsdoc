{
  "name": "@ox-jsdoc/jsdoccomment",
  "version": "0.0.19",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "description": "Maintained replacement for ESLint's deprecated SourceCode#getJSDocComment along with other jsdoc utilities",
  "homepage": "https://github.com/kazupon/ox-jsdoc/tree/main/packages/jsdoccomment#readme",
  "license": "MIT",
  "keywords": [
    "ast",
    "comment",
    "estree",
    "jsdoc",
    "parser",
    "eslint",
    "sourcecode"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "browserslist": [
    "defaults, not op_mini all"
  ],
  "scripts": {
    "build": "pnpm run types",
    "prepublishOnly": "pnpm run build",
    "test": "vp test run",
    "tsc": "tsc",
    "types": "esm-d-ts gen ./src/index.js --output ./dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/ox-jsdoc.git",
    "directory": "packages/jsdoccomment"
  },
  "funding": "https://github.com/sponsors/kazupon",
  "bugs": {
    "url": "https://github.com/kazupon/ox-jsdoc/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "dependencies": {
    "@types/estree": "^1.0.9",
    "@typescript-eslint/types": "^8.72.0",
    "comment-parser": "1.4.9",
    "esquery": "^1.7.0",
    "jsdoc-type-pratt-parser": "~9.4.0",
    "ox-jsdoc": "workspace:*"
  },
  "devDependencies": {
    "@es-joy/escodegen": "^4.2.0",
    "@vitest/coverage-v8": "catalog:",
    "@types/esquery": "^1.5.4",
    "@types/estraverse": "^5.1.7",
    "@typescript-eslint/visitor-keys": "^8.59.4",
    "@typhonjs-build-test/esm-d-ts": "0.4.0",
    "eslint": "^10.0.0",
    "espree": "^11.2.0",
    "estraverse": "^5.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "/dist",
    "/src",
    "README.md",
    "LICENSE-MIT.txt"
  ]
}
